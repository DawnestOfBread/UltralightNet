<Project>
	<PropertyGroup>
		<UltralightVersion>1.3.0</UltralightVersion>

		<GenVersion>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm"))</GenVersion>
		<AssemblyVersion>$(GenVersion)</AssemblyVersion>
		<FileVersion>$(GenVersion)</FileVersion>
		<ProductVersion>$(GenVersion)</ProductVersion>
		<ApplicationVersion>$(GenVersion)</ApplicationVersion>
		<InformationalVersion>$(GenVersion)</InformationalVersion>
		<VersionPrefix>$(GenVersion)</VersionPrefix>
		<VersionSuffix>$(UltralightVersion)</VersionSuffix>

		<Authors>DawnestOfBread,Supine</Authors>
		<RepositoryUrl>https://github.com/DawnestOfBread/UltralightNet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<UseSourceLink>true</UseSourceLink>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
		<PackageOutputPath>$(SolutionDir)</PackageOutputPath>
		<DebugType>Portable</DebugType>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<NoWarn>1006</NoWarn>
		<AnalysisModeReliability>all</AnalysisModeReliability>

		<IsTrimmable>true</IsTrimmable>
		<PublishTrimmed Condition="$(TargetFramework)=='net8.0'">true</PublishTrimmed>
		<TrimMode>full</TrimMode>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<PackageReadmeFile>README.md</PackageReadmeFile>

		<LangVersion>12</LangVersion>

		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" Condition="$(Configuration)==Release"/>

		<None Include="$(MSBuildThisFileDirectory)/README.md" Pack="true" PackagePath="README.md" Condition="$(Configuration)==Release"/>
	</ItemGroup>
</Project>
